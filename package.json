{
  "name": "pixie-pixie-datasource",
  "version": "0.0.10",
  "description": "Pixie's Grafana Datasource Plugin",
  "scripts": {
    "build": "TS_NODE_PROJECT=./.config/webpack/tsconfig.webpack.json webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "TS_NODE_PROJECT=./.config/webpack/tsconfig.webpack.json webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "The Pixie Authors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/toolkit": "8.2.0",
    "@swc/core": "^1.10.15",
    "@swc/helpers": "^0.5.17",
    "@swc/jest": "^0.2.37",
    "@types/prismjs": "^1.26.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-webpack-plugin": "^5.0.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^10.0.0",
    "imports-loader": "^5.0.0",
    "sass": "^1.93.3",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "tslib": "^2.8.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.2.0-rc.1",
    "webpack-virtual-modules": "^0.6.2"
  },
  "resolutions": {
    "rxjs": "^6.6.3",
    "ssri": "^8.0.1",
    "moment": "^2.29.4",
    "@grafana/toolkit/*/immer": "^9.0.6",
    "@grafana/toolkit/*/shell-quote": "^1.7.3",
    "@grafana/toolkit/**/ansi-regex": "^5.0.1",
    "@grafana/toolkit/*/*/yargs-parser": "^18.1.2",
    "@grafana/toolkit/*/*/minimist": "^1.2.6"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@grafana/data": "7.5.14",
    "@grafana/runtime": "7.5.14",
    "@grafana/ui": "7.5.14",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.28.0",
    "react-simple-code-editor": "^0.11.2",
    "typescript": "5.5"
  }
}
